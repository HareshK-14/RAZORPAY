{
  "name": "transactionguard-ai",
  "version": "1.0.0",
  "description": "TransactionGuard AI — Payment Transaction Risk Intelligence Platform",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run backend\" \"npm run frontend\"",
    "backend": "python app.py",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "python app.py",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
